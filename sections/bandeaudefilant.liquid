{% comment %}
  ORSELYNO — Bandeau défilant infini
  Ajouter ce fichier dans /sections/bandeau-defilant.liquid
{% endcomment %}

{% liquid
  assign marquee_repeat = section.settings.repetitions
  assign section_key = section.id | replace: '_', '-'
%}

<style>
  #shopify-section-{{ section.id }} .ors-marquee-{{ section_key }} {
    --ors-background: {{ section.settings.background_color }};
    --ors-color: {{ section.settings.text_color }};
    --ors-separator-color: {{ section.settings.separator_color }};
    --ors-item-gap: {{ section.settings.item_gap_desktop }}px;
    --ors-inline-gap: {{ section.settings.separator_gap }}px;
    --ors-speed: {{ section.settings.speed_desktop }}s;
    background: var(--ors-background);
    color: var(--ors-color);
    position: relative;
    left: 50%;
    width: 100vw;
    max-width: none;
    margin-left: -50vw;
    overflow: hidden;
    box-sizing: border-box;
    {% if section.settings.show_border %}
      border-top: 1px solid {{ section.settings.border_color }};
      border-bottom: 1px solid {{ section.settings.border_color }};
    {% endif %}
  }

  #shopify-section-{{ section.id }} .ors-marquee-{{ section_key }} *,
  #shopify-section-{{ section.id }} .ors-marquee-{{ section_key }} *::before,
  #shopify-section-{{ section.id }} .ors-marquee-{{ section_key }} *::after {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .ors-marquee-{{ section_key }} .ors-marquee__viewport {
    width: 100%;
    padding-block: {{ section.settings.padding_desktop }}px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .ors-marquee-{{ section_key }} .ors-marquee__track {
    width: max-content;
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    will-change: transform;
    animation: ors-slide-{{ section_key }} var(--ors-speed) linear infinite;
    {% if section.settings.direction == 'right' %}
      animation-direction: reverse;
    {% endif %}
    {% unless section.settings.autoplay %}
      animation-play-state: paused;
    {% endunless %}
  }

  #shopify-section-{{ section.id }} .ors-marquee-{{ section_key }} .ors-marquee__group {
    display: flex;
    align-items: center;
    justify-content: space-around;
    flex: 0 0 auto;
    min-width: 100vw;
    gap: var(--ors-item-gap);
    padding-right: var(--ors-item-gap);
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .ors-marquee-{{ section_key }} .ors-marquee__item {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: var(--ors-inline-gap);
    margin: 0;
    padding: 0;
    line-height: 1.35;
    font-size: {{ section.settings.font_size_desktop }}px;
    font-weight: {{ section.settings.font_weight }};
    letter-spacing: {{ section.settings.letter_spacing }}px;
    {% if section.settings.font_choice == 'heading' %}
      font-family: var(--font-heading-family, inherit);
    {% else %}
      font-family: var(--font-body-family, inherit);
    {% endif %}
    {% if section.settings.uppercase %}text-transform: uppercase;{% endif %}
  }

  #shopify-section-{{ section.id }} .ors-marquee-{{ section_key }} .ors-marquee__label,
  #shopify-section-{{ section.id }} .ors-marquee-{{ section_key }} .ors-marquee__label:visited {
    color: inherit;
    text-decoration: none;
    font: inherit;
    line-height: inherit;
    letter-spacing: inherit;
  }

  #shopify-section-{{ section.id }} .ors-marquee-{{ section_key }} a.ors-marquee__label:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .ors-marquee-{{ section_key }} a.ors-marquee__label:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .ors-marquee-{{ section_key }} .ors-marquee__separator {
    color: var(--ors-separator-color);
    font-size: {{ section.settings.separator_size }}px;
    font-weight: 700;
    line-height: 1;
    flex-shrink: 0;
  }

  @keyframes ors-slide-{{ section_key }} {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }

  {% if section.settings.pause_on_hover %}
    #shopify-section-{{ section.id }} .ors-marquee-{{ section_key }}:hover .ors-marquee__track,
    #shopify-section-{{ section.id }} .ors-marquee-{{ section_key }}:focus-within .ors-marquee__track {
      animation-play-state: paused;
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .ors-marquee-{{ section_key }} {
      --ors-item-gap: {{ section.settings.item_gap_mobile }}px;
      --ors-speed: {{ section.settings.speed_mobile }}s;
    }
    #shopify-section-{{ section.id }} .ors-marquee-{{ section_key }} .ors-marquee__viewport {
      padding-block: {{ section.settings.padding_mobile }}px;
    }
    #shopify-section-{{ section.id }} .ors-marquee-{{ section_key }} .ors-marquee__item {
      font-size: {{ section.settings.font_size_mobile }}px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .ors-marquee-{{ section_key }} .ors-marquee__track {
      animation: none !important;
      transform: none !important;
      will-change: auto;
    }
  }
</style>

<div class="ors-marquee-{{ section_key }}" aria-label="{{ section.settings.accessible_title | escape }}">
  <div class="ors-marquee__viewport">
    <div class="ors-marquee__track">
      {% for group_index in (1..2) %}
        <div class="ors-marquee__group" {% if group_index == 2 %}aria-hidden="true"{% endif %}>
          {% for repeat_index in (1..marquee_repeat) %}
            {% for block in section.blocks %}
              {% if block.settings.text != blank %}
                {% assign duplicate = false %}
                {% if group_index == 2 or repeat_index > 1 %}{% assign duplicate = true %}{% endif %}
                <span class="ors-marquee__item" {% if duplicate %}aria-hidden="true"{% endif %} {% if group_index == 1 and repeat_index == 1 %}{{ block.shopify_attributes }}{% endif %}>
                  {% if block.settings.link != blank %}
                    <a class="ors-marquee__label" href="{{ block.settings.link }}" {% if duplicate %}tabindex="-1"{% endif %}>
                      {{ block.settings.text | escape }}
                    </a>
                  {% else %}
                    <span class="ors-marquee__label">{{ block.settings.text | escape }}</span>
                  {% endif %}
                  {% unless section.settings.separator_type == 'none' %}
                    <span class="ors-marquee__separator" aria-hidden="true">
                      {% case section.settings.separator_type %}
                        {% when 'dot' %}•
                        {% when 'diamond' %}◆
                        {% when 'star' %}✦
                        {% when 'line' %}|
                        {% when 'custom' %}{{ section.settings.custom_separator | escape }}
                      {% endcase %}
                    </span>
                  {% endunless %}
                </span>
              {% endif %}
            {% endfor %}
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bandeau défilant infini",
  "tag": "section",
  "class": "section-bandeau-defilant",
  "settings": [
    {"type":"header","content":"Animation"},
    {"type":"checkbox","id":"autoplay","label":"Activer le défilement","default":true},
    {"type":"select","id":"direction","label":"Sens de défilement","default":"left","options":[{"value":"left","label":"Vers la gauche"},{"value":"right","label":"Vers la droite"}]},
    {"type":"range","id":"speed_desktop","label":"Durée du cycle sur ordinateur","min":10,"max":120,"step":2,"unit":"s","default":38},
    {"type":"range","id":"speed_mobile","label":"Durée du cycle sur mobile","min":10,"max":120,"step":2,"unit":"s","default":28},
    {"type":"range","id":"repetitions","label":"Répétitions pour couvrir la largeur","min":3,"max":8,"step":1,"default":5},
    {"type":"checkbox","id":"pause_on_hover","label":"Mettre en pause au survol","default":true},
    {"type":"header","content":"Couleurs"},
    {"type":"color","id":"background_color","label":"Fond du bandeau","default":"#4F1002"},
    {"type":"color","id":"text_color","label":"Couleur des textes","default":"#F7B7A8"},
    {"type":"color","id":"separator_color","label":"Couleur des séparateurs","default":"#F7B7A8"},
    {"type":"checkbox","id":"show_border","label":"Afficher les bordures haut/bas","default":false},
    {"type":"color","id":"border_color","label":"Couleur des bordures","default":"#7A352B"},
    {"type":"header","content":"Typographie"},
    {"type":"select","id":"font_choice","label":"Police du thème","default":"body","options":[{"value":"body","label":"Texte courant"},{"value":"heading","label":"Titres"}]},
    {"type":"range","id":"font_size_desktop","label":"Taille du texte sur ordinateur","min":8,"max":28,"step":1,"unit":"px","default":12},
    {"type":"range","id":"font_size_mobile","label":"Taille du texte sur mobile","min":8,"max":24,"step":1,"unit":"px","default":10},
    {"type":"select","id":"font_weight","label":"Graisse du texte","default":"700","options":[{"value":"400","label":"Normal"},{"value":"500","label":"Moyen"},{"value":"600","label":"Semi-gras"},{"value":"700","label":"Gras"},{"value":"800","label":"Très gras"}]},
    {"type":"checkbox","id":"uppercase","label":"Afficher en majuscules","default":true},
    {"type":"range","id":"letter_spacing","label":"Espacement des lettres","min":0,"max":5,"step":1,"unit":"px","default":1},
    {"type":"header","content":"Dimensions et espacements"},
    {"type":"range","id":"padding_desktop","label":"Marge verticale ordinateur","min":0,"max":60,"step":1,"unit":"px","default":9},
    {"type":"range","id":"padding_mobile","label":"Marge verticale mobile","min":0,"max":60,"step":1,"unit":"px","default":10},
    {"type":"range","id":"item_gap_desktop","label":"Espace entre éléments ordinateur","min":4,"max":80,"step":2,"unit":"px","default":20},
    {"type":"range","id":"item_gap_mobile","label":"Espace entre éléments mobile","min":4,"max":80,"step":2,"unit":"px","default":14},
    {"type":"range","id":"separator_gap","label":"Espace texte / séparateur","min":2,"max":40,"step":2,"unit":"px","default":14},
    {"type":"header","content":"Séparateurs"},
    {"type":"select","id":"separator_type","label":"Symbole entre les messages","default":"dot","options":[{"value":"dot","label":"Point •"},{"value":"diamond","label":"Losange ◆"},{"value":"star","label":"Étoile ✦"},{"value":"line","label":"Barre |"},{"value":"custom","label":"Symbole personnalisé"},{"value":"none","label":"Aucun"}]},
    {"type":"text","id":"custom_separator","label":"Symbole personnalisé","default":"•"},
    {"type":"range","id":"separator_size","label":"Taille des séparateurs","min":6,"max":24,"step":1,"unit":"px","default":11},
    {"type":"header","content":"Accessibilité"},
    {"type":"text","id":"accessible_title","label":"Description du bandeau","default":"Les avantages de nos produits"}
  ],
  "blocks": [
    {
      "type":"message",
      "name":"Message défilant",
      "settings":[
        {"type":"text","id":"text","label":"Texte à afficher","default":"DURABLE"},
        {"type":"url","id":"link","label":"Lien (optionnel)"}
      ]
    }
  ],
  "max_blocks":20,
  "presets":[
    {
      "name":"Bandeau défilant infini",
      "blocks":[
        {"type":"message","settings":{"text":"DURABLE"}},
        {"type":"message","settings":{"text":"SANS PFAS*"}},
        {"type":"message","settings":{"text":"TOUS FEUX"}},
        {"type":"message","settings":{"text":"ULTRA LÉGER"}},
        {"type":"message","settings":{"text":"ANTIADHÉRENT"}}
      ]
    }
  ]
}
{% endschema %}